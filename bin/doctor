#!/usr/bin/env bash
# Checks that everything this repo needs is installed and logged in.
# Each problem comes with the command that fixes it. Exit code 0 = good to go.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1

main() {
  check_os
  check_system_packages
  check_tools
  check_git
  check_github
  check_claude
  check_repo
  echo
  if [ "$problems" -eq 0 ]; then
    echo "${GREEN}All good.${RESET} Run ${BOLD}claude${RESET} here and tell it what you want to build."
    exit 0
  fi
  echo "${RED}$problems problem(s).${RESET} Run the commands above, or run bin/setup again."
  exit 1
}

# Colors only in a real terminal, so the output stays clean when Claude runs it.
if [ -t 1 ]; then
  GREEN=$'\e[32m' YELLOW=$'\e[33m' RED=$'\e[31m' BOLD=$'\e[1m' RESET=$'\e[0m'
else
  GREEN='' YELLOW='' RED='' BOLD='' RESET=''
fi

problems=0
ok() { echo "  ${GREEN}✓${RESET} $1"; }
note() { printf '  %s!%s %s\n      → %s\n' "$YELLOW" "$RESET" "$1" "$2"; }
problem() {
  printf '  %s✗%s %s\n      → %s\n' "$RED" "$RESET" "$1" "$2"
  problems=$((problems + 1))
}

is_mac() { [ "$(uname -s)" = Darwin ]; }
is_wsl() { grep -qis microsoft /proc/version 2>/dev/null; }

check_os() {
  case "$(uname -s)" in
    Darwin) ok "macOS" ;;
    Linux) check_linux_location ;;
    *) problem "unsupported system: $(uname -s)" \
      "Windows: run 'wsl --install' in an admin PowerShell, restart, and work inside Ubuntu" ;;
  esac
}

check_linux_location() {
  if ! is_wsl; then
    ok "Linux"
  elif [[ "$PWD" == /mnt/* ]]; then
    note "this repo is on the Windows drive ($PWD), which is slow in WSL" \
      "clone it inside Linux instead: cd ~ && git clone <repo-url>"
  else
    ok "WSL"
  fi
}

check_system_packages() {
  if is_mac; then
    if xcode-select -p >/dev/null 2>&1; then return; fi
    problem "Apple Command Line Tools missing" "xcode-select --install"
    return
  fi
  local cmd missing=""
  for cmd in git curl unzip make cc; do
    command -v "$cmd" >/dev/null || missing="$missing $cmd"
  done
  if [ -n "$missing" ]; then
    problem "missing system packages:$missing" \
      "sudo apt-get update && sudo apt-get install -y git curl unzip build-essential"
  fi
}

# Every tool in the [tools] table of mise.toml, plus the TypeScript linters
# from package.json.
check_tools() {
  if ! command -v mise >/dev/null; then
    problem "mise not installed" "bin/setup"
    return
  fi
  local tool found=""
  while read -r tool; do
    if ! mise which "$tool" >/dev/null 2>&1; then
      problem "$tool not installed" "mise install"
    elif ! command -v "$tool" >/dev/null; then
      problem "$tool installed but not on PATH" "open a new terminal"
    else
      found="$found, $tool $(mise current "$tool" 2>/dev/null)"
    fi
  done < <(awk '/^\[/{t=($0=="[tools]")} t && /^[a-z]/{print $1}' mise.toml)
  if [ -x node_modules/.bin/oxlint ] && [ -x node_modules/.bin/oxfmt ]; then
    found="$found, oxlint $(package_version oxlint), oxfmt $(package_version oxfmt)"
  else
    problem "TypeScript lint/format tools not installed" "bun install"
  fi
  if [ -n "$found" ]; then ok "tools: ${found#, }"; fi
}

package_version() { sed -n 's/^ *"version": *"\(.*\)".*/\1/p' "node_modules/$1/package.json" | head -1; }

check_git() {
  local name email
  name="$(git config --get user.name)"
  email="$(git config --get user.email)"
  if [ -z "$name" ]; then problem "git name not set" 'git config --global user.name "Your Name"'; fi
  if [ -z "$email" ]; then problem "git email not set" 'git config --global user.email "you@example.com"'; fi
  if [ -n "$name" ] && [ -n "$email" ]; then ok "git: $name <$email>"; fi
}

check_github() {
  command -v gh >/dev/null || return
  if ! gh auth status >/dev/null 2>&1; then
    problem "not logged in to GitHub" "gh auth login --web --git-protocol https"
    return
  fi
  if ! git config --get-regexp '^credential\..*github\.com.*\.helper$' 2>/dev/null | grep -q 'gh auth'; then
    problem "git push won't use your GitHub login" "gh auth setup-git"
    return
  fi
  ok "GitHub: logged in as $(gh api user -q .login 2>/dev/null || echo '?')"
}

check_claude() {
  if ! command -v claude >/dev/null; then
    problem "Claude Code not installed" "curl -fsSL https://claude.ai/install.sh | bash"
    return
  fi
  local status
  if ! status="$(bin/use check)"; then
    problem "$status" "bin/use tamu   (TAMU AI Chat key)   or   bin/use claude   (Claude subscription)"
    return
  fi
  ok "Claude Code $(claude --version 2>/dev/null | awk '{print $1}'): $status"
}

check_repo() {
  if ! grep -qs lefthook .git/hooks/pre-commit; then
    problem "pre-commit hooks not installed" "bin/setup"
  fi
  local status
  if status="$(bin/make-it-mine --check)"; then
    ok "$status"
  else
    note "$status" "bin/make-it-mine   (makes your own GitHub repo; run once)"
  fi
}

main "$@"
