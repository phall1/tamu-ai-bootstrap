#!/usr/bin/env bash
# Sets up everything this repo needs, then opens Claude Code.
# Safe to re-run any time: it skips whatever is already done.
# In a TAMU workspace (TAMU_WORKSPACE=1) the platform has already set up git,
# Claude, and the tools, so this asks nothing and doesn't start Claude.
set -euo pipefail
cd "$(dirname "$0")/.." || exit 1

main() {
  check_os
  check_system_packages
  install_mise
  install_tools
  install_claude
  install_git_hooks
  if in_workspace; then
    connect_github_if_logged_in
  elif is_terminal; then
    log_in_to_github
    set_git_identity
    choose_claude_access
  fi
  say "Checking everything"
  bin/doctor || exit 1
  if is_terminal && ! in_workspace; then
    start_claude
  fi
}

say() { printf '\n\033[1m==> %s\033[0m\n' "$*"; }
is_terminal() { [ -t 0 ] && [ -t 1 ]; }
in_workspace() { [ "${TAMU_WORKSPACE:-}" = 1 ]; }
is_mac() { [ "$(uname -s)" = Darwin ]; }
github_logged_in() { gh auth status >/dev/null 2>&1; }

check_os() {
  case "$(uname -s)" in
    Darwin | Linux) return ;;
  esac
  echo "This repo needs macOS, Linux, or WSL on Windows."
  echo "Windows: open PowerShell as admin, run 'wsl --install', restart,"
  echo "then open the Ubuntu app and clone this repo inside it (not under /mnt/c)."
  exit 1
}

# The few things mise can't install: git and compilers (Apple Command Line
# Tools on macOS) or the basic Linux packages that mise and bun need.
check_system_packages() {
  if is_mac; then
    if xcode-select -p >/dev/null 2>&1; then return; fi
    echo "Installing Apple Command Line Tools - click Install in the popup."
    xcode-select --install || true
    echo "When that finishes, run bin/setup again."
    exit 1
  fi
  local cmd missing=""
  for cmd in git curl unzip make cc; do
    command -v "$cmd" >/dev/null || missing="$missing $cmd"
  done
  if [ -z "$missing" ]; then return; fi
  echo "Missing:$missing. Run this, then run bin/setup again:"
  echo "  sudo apt-get update && sudo apt-get install -y git curl unzip build-essential"
  exit 1
}

install_mise() {
  export PATH="$HOME/.local/bin:$PATH"
  if ! command -v mise >/dev/null; then
    say "Installing mise (manages tool versions)"
    curl -fsSL https://mise.run | sh
  fi
  activate_mise_in_shell
}

# New terminals need mise on PATH so the tools (and Claude) can find them.
# A workspace already has mise on PATH everywhere.
activate_mise_in_shell() {
  if in_workspace; then return; fi
  local shell_name="${SHELL##*/}" rc
  case "$shell_name" in
    zsh) rc="$HOME/.zshrc" ;;
    bash) rc="$HOME/.bashrc" ;;
    *)
      echo "Unknown shell '$SHELL'. Activate mise yourself: https://mise.jdx.dev/getting-started.html"
      return
      ;;
  esac
  if grep -qs 'mise activate' "$rc"; then return; fi
  local line="eval \"\$($HOME/.local/bin/mise activate $shell_name)\""
  printf '\n# mise (tool versions)\n%s\n' "$line" >>"$rc"
}

install_tools() {
  say "Installing tools (mise.toml, package.json)"
  mise trust --quiet .
  mise install
  eval "$(mise activate bash --shims)" # tools on PATH for the rest of this script
  bun install --frozen-lockfile
}

install_claude() {
  if command -v claude >/dev/null; then return; fi
  say "Installing Claude Code"
  curl -fsSL https://claude.ai/install.sh | bash
}

install_git_hooks() {
  if [ ! -d .git ]; then git init -q; fi
  lefthook install >/dev/null
}

log_in_to_github() {
  if ! github_logged_in; then
    say "Log in to GitHub"
    gh auth login --web --git-protocol https
  fi
  connect_github_if_logged_in
}

# Plain `git push` then uses the GitHub login. Skipped if there isn't one.
connect_github_if_logged_in() {
  if github_logged_in; then gh auth setup-git; fi
}

# Suggests the GitHub name and GitHub's private noreply email, so commits
# don't publish a real address.
set_git_identity() {
  local key value suggestion
  for key in user.name user.email; do
    if git config --get "$key" >/dev/null; then continue; fi
    suggestion="$(github_suggestion "$key")"
    read -r -p "Your git $key${suggestion:+ [$suggestion]}: " value
    value="${value:-$suggestion}"
    if [ -n "$value" ]; then git config --global "$key" "$value"; fi
  done
}

github_suggestion() {
  case "$1" in
    user.name) gh api user -q '.name // .login' 2>/dev/null || true ;;
    user.email) gh api user -q '"\(.id)+\(.login)@users.noreply.github.com"' 2>/dev/null || true ;;
  esac
}

# Claude Code works with either a TAMU AI Chat API key or a personal Claude
# subscription. bin/use switches between them later.
choose_claude_access() {
  if bin/use check >/dev/null 2>&1; then return; fi
  say "How will you use Claude?"
  echo "  1) TAMU AI Chat API key (no subscription needed)"
  echo "  2) My own Claude subscription (Pro or Max)"
  local choice
  read -r -p "Choose 1 or 2 [1]: " choice
  case "$choice" in
    2) bin/use claude ;;
    *) bin/use tamu ;;
  esac
}

start_claude() {
  say "Starting Claude Code"
  echo "If it asks whether you trust this folder, choose Yes."
  echo "Next time, just run: cd $PWD && claude"
  exec claude /start
}

main "$@"
